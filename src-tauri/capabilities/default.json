{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window - restricted to essential commands only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default"
  ],
  "remote": {
    "urls": [
      "https://app.plex.tv",
      "https://*.plex.tv",
      "https://*.plex.direct"
    ]
  }
}